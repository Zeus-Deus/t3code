{
  "id": "examples.workflow-board",
  "name": "Workflow Board",
  "description": "A plugin-owned review queue with a workspace page and optional completion follow-ups.",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "plugin.mjs",
  "capabilities": [
    "ui",
    "storage",
    "settings",
    "threads.read",
    "threads.send",
    "threads.create",
    "events.run-finalized"
  ],
  "actions": [
    {
      "id": "open-board",
      "title": "Open workflow board",
      "placements": ["palette", "thread-menu"]
    },
    {
      "id": "save-selection",
      "title": "Save selection to workflow board",
      "placements": ["message-selection", "thread-menu"]
    },
    {
      "id": "new-review-thread",
      "title": "Start a review thread",
      "placements": ["palette", "thread-menu"],
      "agentCallable": true
    }
  ],
  "views": [
    { "id": "board", "title": "Workflow Board", "entry": "view.html", "placement": "page" }
  ],
  "settings": [
    {
      "key": "autoFollowup",
      "label": "Request a completion review automatically",
      "description": "After a successful turn, send one review prompt to its thread. Plugin-originated turns are capped by the host. Off by default.",
      "type": "boolean",
      "default": false
    }
  ]
}
